---
import Layout from '../layouts/Layout.astro';

// 내 정보 데이터 설정
const name = "홍길동";
const role = "학생 개발자";
const description = "새로운 기술을 배우고 직접 만드는 것에 즐거움을 느낍니다.";

// 대표 프로젝트 목록
const projects = [
  {
    title: "프로젝트 1",
    description: "어떤 기술로 어떤 문제를 해결했는지 간단한 소개",
    tags: ["HTML/CSS", "JavaScript"],
    link: "#"
  },
  {
    title: "프로젝트 2",
    description: "직접 만든 토이 프로젝트나 게임, 앱 등",
    tags: ["Astro", "Git"],
    link: "#"
  }
];
---

<Layout>
  <main class="container">
    <!-- 1. Hero / 소개 섹션 -->
    <section class="hero">
      <span class="badge">{role}</span>
      <h1>안녕하세요, <br /><span>{name}</span>입니다.</h1>
      <p>{description}</p>
      
      <div class="links">
        <a href="https://github.com" target="_blank" class="btn primary">GitHub 바로가기</a>
        <a href="/about" class="btn secondary">자세한 소개</a>
      </div>
    </section>

    <!-- 2. 프로젝트 섹션 -->
    <section class="projects">
      <h2>Featured Projects</h2>
      <div class="grid">
        {projects.map((project) => (
          <div class="card">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="tags">
              {project.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
            <a href={project.link} class="card-link">자세히 보기 →</a>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  /* 기본 레이아웃 스타일 */
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    font-family: system-ui, -apple-system, sans-serif;
    color: #1a1a1a;
  }

  /* Hero 섹션 */
  .hero {
    margin-bottom: 4rem;
  }
  .badge {
    background: #eff6ff;
    color: #2563eb;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
  }
  h1 {
    font-size: 2.5rem;
    margin: 1rem 0;
    line-height: 1.2;
  }
  h1 span {
    color: #2563eb;
  }
  p {
    font-size: 1.125rem;
    color: #4b5563;
    margin-bottom: 1.5rem;
  }

  /* 버튼 스타일 */
  .links {
    display: flex;
    gap: 1rem;
  }
  .btn {
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
    transition: background 0.2s;
  }
  .btn.primary {
    background: #2563eb;
    color: white;
  }
  .btn.primary:hover {
    background: #1d4ed8;
  }
  .btn.secondary {
    background: #f3f4f6;
    color: #374151;
  }

  /* 프로젝트 카드 그리드 */
  .projects h2 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .card {
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 1.5rem;
    background: #ffffff;
    display: flex;
    flex-direction: column;
  }
  .card h3 {
    margin: 0 0 0.5rem 0;
  }
  .card p {
    font-size: 0.95rem;
    flex-grow: 1;
  }
  .tags {
    display: flex;
    gap: 0.5rem;
    margin: 1rem 0;
  }
  .tag {
    background: #f3f4f6;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: #4b5563;
  }
  .card-link {
    color: #2563eb;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>