---
import Layout from '../layouts/Layout.astro';

// 로비에서 연결할 세부 웹사이트 / 서비스 목록
const sites = [
  {
    title: "🎬 윤서준 모음집",
    description: "윤서준의 주요 영상들을 모아놓은 영상 플레이어 사이트입니다.",
    path: "/yoon",
    badge: "비디오",
    color: "#3b82f6"
  },
  {
    title: "🎲 주사위 리듬게임 (모바일)",
    description: "모바일로 즐기는 원핸드 주사위 리듬게임입니다.",
    path: "/dice",
    badge: "리듬게임",
    color: "#10b981"
  }
];
---

<Layout title="Trigger302">
  <main class="lobby-container">
    <header class="lobby-header">
      <span class="sub-title">WEB SERVICE HUB</span>
      <h1>Trigger302</h1>
      <p>아래 카드 중 하나를 선택하여 세부 웹사이트로 이동하세요.</p>
    </header>

    <section class="card-grid">
      {sites.map((site) => (
        <a href={site.path} class="site-card" style={`--accent-color: ${site.color}`}>
          <div class="card-header">
            <span class="badge">{site.badge}</span>
            <span class="arrow">→</span>
          </div>
          <h2>{site.title}</h2>
          <p>{site.description}</p>
        </a>
      ))}
    </section>
  </main>
</Layout>

<style>
  /* 로비 전용 고유 CSS 스타일 */
  :global(body) {
    background-color: #0b0f19;
    color: #f3f4f6;
    font-family: 'Pretendard', system-ui, sans-serif;
    margin: 0;
  }

  .lobby-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .lobby-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .sub-title {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: #60a5fa;
  }

  .lobby-header h1 {
    font-size: 2.8rem;
    margin: 0.5rem 0 1rem 0;
    background: linear-gradient(to right, #ffffff, #9ca3af);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .lobby-header p {
    color: #9ca3af;
    font-size: 1.1rem;
  }

  /* 카드 그리드 */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .site-card {
    background: #111827;
    border: 1px solid #1f2937;
    border-radius: 16px;
    padding: 1.8rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }

  .site-card:hover {
    transform: translateY(-6px);
    border-color: var(--accent-color);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
  }

  .badge {
    background: #1f2937;
    color: var(--accent-color);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.3rem 0.7rem;
    border-radius: 20px;
  }

  .arrow {
    font-size: 1.2rem;
    color: #4b5563;
    transition: transform 0.2s, color 0.2s;
  }

  .site-card:hover .arrow {
    transform: translateX(4px);
    color: var(--accent-color);
  }

  .site-card h2 {
    font-size: 1.4rem;
    margin: 0 0 0.8rem 0;
  }

  .site-card p {
    color: #9ca3af;
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }
</style>