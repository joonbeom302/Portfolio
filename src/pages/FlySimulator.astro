<div class="simulator-container">
  <!-- 3D 공간 뷰어 영역 (전체 화면) -->
  <div class="viewer-section">
    <canvas id="three-canvas"></canvas>
  </div>

  <!-- 우측 상단 오버레이 대시보드 (신경망 시각화) -->
  <div class="dashboard-section">
    <div class="neural-box">
      <h3>Neural Activity</h3>
      <p class="neuron-count">Simulated Point Cloud Brain</p>
      <div class="canvas-wrapper">
        <canvas id="neural-canvas" width="300" height="400"></canvas>
      </div>
      <div class="status-indicator">
        상태: <span id="active-state">Resting (직선 비행)</span>
      </div>
    </div>
  </div>
</div>
<!-- 
<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

  const canvas = document.getElementById('three-canvas') as HTMLCanvasElement | null;
  const neuralCanvas = document.getElementById('neural-canvas') as HTMLCanvasElement | null;
  const activeStateEl = document.getElementById('active-state') as HTMLElement | null;

  if (canvas && neuralCanvas && activeStateEl) {
    const nCtx = neuralCanvas.getContext('2d');

    if (nCtx) {
      // --- 1. Three.js 뷰어 (전체 화면 & 컨트롤 추가) ---
      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x1a202c);
      scene.fog = new THREE.Fog(0x1a202c, 10, 40);

      const roomSize = 20;
      const gridHelper = new THREE.GridHelper(roomSize, 20, 0x4a5568, 0x2d3748);
      gridHelper.position.y = -roomSize / 2;
      scene.add(gridHelper);

      const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
      scene.add(ambientLight);

      const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 100);
      camera.position.set(0, 5, 15);

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      // 드래그 회전 컨트롤 추가
      const controls = new OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.05;

      // --- 2. 초파리 모델 (임시 형태, 추후 GLB로 교체 권장) ---
      const flyGroup = new THREE.Group();
      const bodyMat = new THREE.MeshStandardMaterial({ color: 0xcbd5e1 });
      const body = new THREE.Mesh(new THREE.SphereGeometry(0.4, 16, 16), bodyMat);
      body.scale.set(1, 1, 1.5);
      flyGroup.add(body);
      scene.add(flyGroup);

      // 초파리 비행 변수 (사카드 비행 로직)
      const pos = new THREE.Vector3(0, 0, 0);
      let direction = new THREE.Vector3(0, 0, -1);
      const speed = 0.1;
      let saccadeCooldown = 0;

      // --- 3. 뇌 신경망 파티클 (점묘화 형태) 생성 ---
      const brainParticles = [];
      for (let i = 0; i < 2000; i++) {
        // 임의의 뇌 형태(위쪽 양갈래, 아래쪽 꼬리)로 점 배치
        const x = (Math.random() - 0.5) * 200;
        const y = (Math.random() - 0.5) * 250;
        let region = 'central';
        
        // 형태 잡기: 중심부에서 먼 곳은 확률적으로 제거
        if (y < -50 && Math.abs(x) < 50) region = 'motor'; // 하단 신경 (운동)
        else if (y > 0 && Math.abs(x) > 40) region = 'visual'; // 상단 양측 (시각)
        
        brainParticles.push({ x: 150 + x, y: 200 + y, region, baseAlpha: Math.random() * 0.3 + 0.1 });
      }

      const drawBrain = (activeType: string) => {
        nCtx.clearRect(0, 0, neuralCanvas.width, neuralCanvas.height);
        
        brainParticles.forEach(p => {
          let alpha = p.baseAlpha;
          let color = '255, 255, 255'; // 기본 흰색 점

          // 상태에 따라 특정 구역의 파티클이 강하게 빛남
          if (activeType === 'avoid' && (p.region === 'visual' || p.region === 'motor')) {
            if (Math.random() > 0.7) { alpha = 0.9; color = '239, 68, 68'; } // 빨간색 점멸
          } else if (activeType === 'saccade' && p.region === 'central') {
            if (Math.random() > 0.7) { alpha = 0.9; color = '56, 189, 248'; } // 파란색 점멸
          }

          nCtx.fillStyle = `rgba(${color}, ${alpha})`;
          nCtx.fillRect(p.x, p.y, 2, 2); // 픽셀 크기
        });
      };

      // --- 4. 메인 애니메이션 루프 ---
      const animate = () => {
        requestAnimationFrame(animate);
        controls.update();

        let activeType = 'normal';
        activeStateEl.innerText = 'Resting (직선 비행)';
        activeStateEl.style.color = '#cbd5e1';

        // 전방 벽 감지 (Raycasting 대신 간단한 거리 측정)
        const nextPos = pos.clone().add(direction.clone().multiplyScalar(speed * 20));
        const limit = roomSize / 2 - 1;

        if (Math.abs(nextPos.x) > limit || Math.abs(nextPos.y) > limit || Math.abs(nextPos.z) > limit) {
          // 장애물 감지 시 부드럽게가 아니라 확 꺾음 (회피)
          direction.x += (Math.random() - 0.5) * 2;
          direction.y += (Math.random() - 0.5) * 2;
          direction.z += (Math.random() - 0.5) * 2;
          direction.normalize();
          activeType = 'avoid';
          activeStateEl.innerText = 'Optic Flow 감지: 긴급 회피';
          activeStateEl.style.color = '#ef4444';
          saccadeCooldown = 30; // 꺾은 후 잠시 직선 비행
        } 
        else if (saccadeCooldown <= 0 && Math.random() < 0.02) {
          // 사카드(Saccade): 갑자기 휙 방향을 틈
          direction.applyAxisAngle(new THREE.Vector3(0, 1, 0), (Math.random() - 0.5) * Math.PI);
          activeType = 'saccade';
          activeStateEl.innerText = 'Saccade (자율 방향 전환)';
          activeStateEl.style.color = '#38bdf8';
          saccadeCooldown = 50;
        }

        if (saccadeCooldown > 0) saccadeCooldown--;

        // 이동 및 회전 적용
        pos.add(direction.clone().multiplyScalar(speed));
        flyGroup.position.copy(pos);
        
        const targetLook = pos.clone().add(direction);
        flyGroup.lookAt(targetLook);

        drawBrain(activeType);
        renderer.render(scene, camera);
      };

      animate();

      // 리사이즈 처리
      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });
    }
  }
</script> -->

<style>
  /* 화면 전체를 덮도록 수정 */
  :global(body) { margin: 0; overflow: hidden; background-color: #1a202c; }
  
  .simulator-container {
    position: relative;
    width: 100vw;
    height: 100vh;
  }

  .viewer-section {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
  }

  /* 첫 사진처럼 우측에 떠 있는 신경망 뷰어 */
  .dashboard-section {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 340px;
    pointer-events: none; /* 마우스 이벤트는 뒤의 3D 화면으로 넘김 */
  }

  .neural-box {
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(10px);
    padding: 20px;
    border-radius: 12px;
    border: 1px solid #334155;
    color: white;
  }

  .neural-box h3 { margin: 0; font-size: 1.2rem; font-weight: 600; }
  .neuron-count { margin: 5px 0 15px 0; font-size: 0.8rem; color: #94a3b8; }
  
  .canvas-wrapper {
    display: flex;
    justify-content: center;
  }

  .status-indicator {
    margin-top: 15px;
    font-size: 0.9rem;
    font-weight: 500;
  }
</style>